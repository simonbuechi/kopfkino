rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getProject(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function projectExists(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId));
    }

    function isMember(projectId) {
      return request.auth.uid in getProject(projectId).members;
    }

    function memberRole(projectId) {
      return getProject(projectId).members[request.auth.uid].role;
    }

    function canWrite(projectId) {
      return projectExists(projectId)
        && isMember(projectId)
        && memberRole(projectId) in ['owner', 'editor'];
    }

    function isSelfJoiningMember() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role in ['editor', 'viewer'];
    }

    // Top-level project documents
    match /projects/{projectId} {
      allow read: if isSignedIn() && isMember(projectId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (canWrite(projectId) || isSelfJoiningMember());
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Project subcollections (locations, scenes, characters, plans, tasks, etc.)
      match /{collectionName}/{document=**} {
        allow read: if isSignedIn() && isMember(projectId);
        allow write: if isSignedIn() && canWrite(projectId);
      }
    }

    // Invitations — project writers can create/manage; invitee can read/accept
    match /invitations/{invitationId} {
      allow create: if isSignedIn() && canWrite(request.resource.data.projectId);
      allow read, update: if isSignedIn() && (
        request.auth.token.email == resource.data.email || canWrite(resource.data.projectId)
      );
      allow delete: if isSignedIn() && (
        request.auth.token.email == resource.data.email || canWrite(resource.data.projectId)
      );
    }

    // User-scoped data: settings, projectRefs index, migration marker
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /settings/{doc} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /projectRefs/{projectId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && (request.auth.uid == userId || canWrite(projectId));
      }

      match /meta/{doc} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Legacy subcollections — read-only after migration (kept for old image URLs, etc.)
      match /{collectionName}/{document=**} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Global knowledge base (accessible to all signed-in users)
    match /knowledge/{itemId} {
      allow read, write: if isSignedIn();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
