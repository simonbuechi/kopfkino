rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function getProjectData(projectId) {
      return firestore.get(
        /databases/(default)/documents/projects/$(projectId)
      ).data;
    }

    function isProjectMember(projectId) {
      return request.auth != null
        && request.auth.uid in getProjectData(projectId).members;
    }

    function canWriteProject(projectId) {
      return isProjectMember(projectId)
        && getProjectData(projectId).members[request.auth.uid].role in ['owner', 'editor'];
    }

    // Project-scoped paths
    match /projects/{projectId}/images/{allPaths=**} {
      allow read: if isProjectMember(projectId);
      allow write: if canWriteProject(projectId)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /projects/{projectId}/videos/{allPaths=**} {
      allow read: if isProjectMember(projectId);
      allow write: if canWriteProject(projectId)
                   && request.resource.size < 100 * 1024 * 1024
                   && (request.resource.contentType.matches('video/.*')
                       || request.resource.contentType == 'application/octet-stream');
    }

    // Legacy user-scoped paths — read-only to keep existing image URLs working
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // Global knowledge base media (images, videos, breakdown strips)
    match /knowledge/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*')
                       || request.resource.contentType == 'application/octet-stream');
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
